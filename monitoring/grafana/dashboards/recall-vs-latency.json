{
  "uid": "vf-recall-latency",
  "title": "VectorForge Recall vs Latency",
  "description": "The core tradeoff of approximate search: how much recall you keep and what it costs in latency. The live panels track the current operating point over time; the full swept curve across ef values comes from the benchmark suite.",
  "tags": ["vectorforge"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About this dashboard",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Recall and latency pull against each other: a wider search beam (higher `ef`) finds more true neighbours but takes longer. These panels show where the running index sits right now. The full recall-versus-latency curve, swept across `ef` values against brute-force ground truth, is produced by the benchmark suite and is the centerpiece chart in the README. Recall and p95 latency live on separate panels on purpose, since they use different scales and a single dual-axis panel would be misleading."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current recall@k",
      "description": "Latest measured recall against brute-force ground truth.",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "vectorforge-prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "vectorforge_recall_at_k",
          "datasource": { "type": "prometheus", "uid": "vectorforge-prom" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current p95 latency",
      "description": "Latest 95th percentile search latency.",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "vectorforge-prom" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(vectorforge_query_latency_seconds_bucket[5m])) by (le))",
          "datasource": { "type": "prometheus", "uid": "vectorforge-prom" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.015 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Recall@k over time",
      "description": "How recall drifts as the index grows and as deletes accumulate.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "vectorforge-prom" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "recall@k",
          "expr": "vectorforge_recall_at_k",
          "datasource": { "type": "prometheus", "uid": "vectorforge-prom" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 latency over time",
      "description": "The latency half of the tradeoff, on its own seconds axis.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "vectorforge-prom" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum(rate(vectorforge_query_latency_seconds_bucket[5m])) by (le))",
          "datasource": { "type": "prometheus", "uid": "vectorforge-prom" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ]
}
